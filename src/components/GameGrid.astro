---
import type { Game } from '../data/schema';
import GameCard from './GameCard.astro';

interface Props { games: Game[]; }
const { games } = Astro.props;
---

<div class="game-grid" data-game-grid>
  {games.map((game, index) => <GameCard game={game} index={index} />)}
</div>

<template data-game-card-template>
  <article class="game-card" data-game-card>
    <a class="cover-link" data-card-cover-link>
      <span class="catalog-number" aria-hidden="true" data-card-number></span>
      <img data-card-cover loading="lazy" decoding="async" width="480" height="680" />
      <span class="cover-arrow" aria-hidden="true">↗</span>
    </a>
    <div class="card-copy">
      <h2><a data-card-title-link></a></h2>
    </div>
  </article>
</template>

<div class="empty-state" data-empty-state hidden>
  <span aria-hidden="true">∅</span>
  <h2 data-i18n="empty.title">Nada por aquí</h2>
  <p data-i18n="empty.body">Prueba con otro título o limpia la búsqueda.</p>
  <button type="button" data-clear-search data-i18n="empty.action">Ver toda la colección</button>
</div>

<div class="load-more-wrap" data-load-more-wrap aria-live="polite">
  <button class="load-more" type="button" data-load-more>
    <span data-i18n="load.more">Cargar más</span>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M5 12l7 7 7-7"></path></svg>
  </button>
</div>
