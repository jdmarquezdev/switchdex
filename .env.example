# Fuente HTTPS compatible. Si se omite, se usa el fixture local de demostración.
CATALOG_SOURCE_URL=https://raw.githubusercontent.com/Langegen/switch-games/main/switch_games.json
CATALOG_SOURCE_TYPE=langegen-switch-games
CATALOG_FETCH_TIMEOUT_MS=30000
CATALOG_MAX_BYTES=52428800
CATALOG_CACHE_DIR=.cache/catalog
CATALOG_INCLUDE_SOURCE_URLS=false
CATALOG_SYNC_ENABLED=true
CATALOG_SYNC_INTERVAL_MINUTES=60
# Opcional para URLs que no sean raw.githubusercontent.com; debe devolver un objeto con `sha`.
#CATALOG_SOURCE_SHA_URL=https://api.github.com/repos/Langegen/switch-games/contents/switch_games.json?ref=main

# Solo frontend SSR: URL interna o pública de la API de catálogo.
CATALOG_API_URL=http://127.0.0.1:8787

# Traducción opcional y manual de descripciones.
# Proveedores: openai | anthropic | gemini | glm | kimi | openrouter | ollama | lmstudio
# ollama y lmstudio ejecutan IA local sin clave; el resto necesita TRANSLATION_API_KEY.
# No guardes la clave real en el repositorio.
TRANSLATION_PROVIDER=ollama
TRANSLATION_API_KEY=
# URL opcional para endpoints propios (se deduce del proveedor si se omite).
#TRANSLATION_URL=http://127.0.0.1:11434/api
TRANSLATION_MODEL=qwen3.5:397b-cloud
TRANSLATION_BATCH_SIZE=4
TRANSLATION_TIMEOUT_MS=600000
# Solo para Ollama: separa el razonamiento del texto en modelos compatibles.
TRANSLATION_THINK=low

# Alias de compatibilidad con la configuración anterior basada en Ollama.
# Si TRANSLATION_PROVIDER no está definida, se usan estos valores.
#OLLAMA_API_KEY=
#OLLAMA_URL=
#OLLAMA_MODEL=

# API opcional para traducir una ficha al vuelo. Se enlaza solo a localhost.
TRANSLATION_API_HOST=127.0.0.1
TRANSLATION_API_PORT=8787
# Orígenes web permitidos, completos y separados por comas. La coincidencia es exacta.
TRANSLATION_ALLOWED_ORIGINS=https://catalog.example.com
TRANSLATION_DAILY_LIMIT=100
TRANSLATION_HOURLY_IP_LIMIT=10

SITE_URL=https://catalog.example.com
SITE_NAME=SwitchDex
SITE_DESCRIPTION=Una biblioteca ligera para explorar tu catálogo de juegos.

REMOTE_IMAGES=true
IMAGE_PROXY_ENABLED=false
