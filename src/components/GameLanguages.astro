---
import type { Game } from '../data/schema';
import LanguageFlag from './LanguageFlag.astro';

interface Props { game: Game; }
const { game } = Astro.props;

const FLAG_CODES: Record<string, string> = {
  'Español': 'es',
  'Inglés': 'gb',
  'Francés': 'fr',
  'Alemán': 'de',
  'Italiano': 'it',
  'Japonés': 'jp',
  'Portugués': 'pt',
  'Ruso': 'ru',
  'Chino': 'cn',
  'Coreano': 'kr',
  'Neerlandés': 'nl',
  'Polaco': 'pl',
  'Ucraniano': 'ua',
  'Checo': 'cz',
  'Turco': 'tr',
  'Árabe': 'ae'
};

interface LanguageGroup {
  key: 'general' | 'interface' | 'voice';
  label: string;
  i18nKey: string;
  languages: string[];
}

const toFlagItems = (languages: string[]) => languages.map((language) => ({
  language,
  code: /^multi(?:\s|$)/i.test(language) ? 'multi' : FLAG_CODES[language]
}));

const generalLanguages = game.generalLanguages ?? (
  game.interfaceLanguages.length === 0 && game.voiceLanguages.length === 0 ? game.languages : []
);

const groups: LanguageGroup[] = [];
if (game.interfaceLanguages.length > 0) {
  groups.push({ key: 'interface', label: 'Texto', i18nKey: 'detail.textLanguages', languages: game.interfaceLanguages });
} else if (generalLanguages.length > 0) {
  groups.push({ key: 'general', label: 'Idiomas', i18nKey: 'detail.unspecifiedLanguages', languages: generalLanguages });
}
if (game.voiceLanguages.length > 0) {
  groups.push({ key: 'voice', label: 'Voces', i18nKey: 'detail.voiceLanguages', languages: game.voiceLanguages });
}
---

{groups.length > 0 && (
  <div class="language-groups" aria-label="Idiomas del juego" data-i18n-aria="detail.languagesLabel">
    {groups.map((group) => (
      <div class="language-group">
        <p class="language-group-label" data-i18n={group.i18nKey}>{group.label}</p>
        <ul class="language-flags">
          {toFlagItems(group.languages).map((item) => (
            <li>
              <LanguageFlag code={item.code} label={item.language} />
              <span>{item.language}</span>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
)}
