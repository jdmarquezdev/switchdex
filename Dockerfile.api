FROM node:22-alpine
WORKDIR /app
ENV TRANSLATION_API_HOST=0.0.0.0 TRANSLATION_API_PORT=8787 NODE_ENV=production
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY server ./server
COPY scripts ./scripts
COPY src/data ./src/data
COPY tests/fixtures ./tests/fixtures
EXPOSE 8787
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 CMD node -e "fetch('http://127.0.0.1:8787/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["npm", "run", "api:start"]
