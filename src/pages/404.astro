---
import BaseLayout from '../layouts/BaseLayout.astro';
Astro.response.status = 404;
---

<BaseLayout title="Página no encontrada">
  <section class="not-found">
    <p data-i18n="notFound.kicker">404 / Fuera de catálogo</p>
    <h1><span data-i18n="notFound.title">Esta historia no está</span><br /><em data-i18n="notFound.emphasis">en la estantería.</em></h1>
    <a class="source-link" href="/"><span data-i18n="notFound.cta">Volver al catálogo</span> <span class="source-arrow">→</span></a>
  </section>
</BaseLayout>
