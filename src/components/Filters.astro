<div class="filters-panel sort-panel">
  <div class="filters-grid">
    <label class="sort-filter">
      <span data-i18n="sort.label">Ordenar</span>
      <select name="sort" data-sort>
        <option value="newest" data-i18n="sort.newest">Más recientes</option>
        <option value="title-asc" data-i18n="sort.titleAsc">Título A–Z</option>
        <option value="title-desc" data-i18n="sort.titleDesc">Título Z–A</option>
        <option value="oldest" data-i18n="sort.oldest">Más antiguos</option>
      </select>
    </label>
  </div>
</div>
